# Configuracion del backend M-Learning Early Warning
# Ajusta USER y PASSWORD a tu instalacion de PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/mlearning

JWT_SECRET=mlearning-demo-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Origenes permitidos para CORS (separados por coma, o * para todos)
CORS_ORIGINS=*
